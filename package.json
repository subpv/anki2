{
  "name": "card",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spaced repetition for engineers: FSRS scheduling, LaTeX, numeric and parametrised cards.",
  "scripts": {
    "dev:server": "AUTH_DEV_BYPASS=1 tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.11",
    "@open-spaced-repetition/binding": "^0.5.0",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "openid-client": "^6.9.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "dompurify": "^3.4.18",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.73.0",
    "markdown-it": "^15.0.3",
    "mathjs": "^15.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
